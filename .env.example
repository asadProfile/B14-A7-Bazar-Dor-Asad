# ---------------------------------------------------------------------------
# BazarDor environment variables
# Copy to `.env.local` and fill in. Only BETTER_AUTH_SECRET is required to run
# locally — everything else has a working default.
# ---------------------------------------------------------------------------

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public origin of the app. Used for social-login redirects.
# Local:    http://localhost:3000
# Deployed: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (optional)
# Leave blank for local development — a SQLite file (`bazardor.db`) is created
# in the project root automatically. On serverless hosts such as Vercel, point
# these at a free Turso database (https://turso.tech) so sessions survive.
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Social login (optional)
# Create these in the Google Cloud Console / GitHub Developer Settings and add
# <BETTER_AUTH_URL>/api/auth/callback/google (or .../github) as the redirect URI.
# A provider with no keys still shows its button; clicking it explains what is
# missing instead of failing with an opaque configuration error.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
